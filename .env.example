# Copie para .env e preencha somente com as bases reais dos grupos Xano.
# Não incluir caminhos de endpoints no final das URLs.
XANO_AUTH_API_URL=
XANO_CATALOG_API_URL=
XANO_CUSTOMER_API_URL=
